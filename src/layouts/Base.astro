---
import '../styles/global.css';
import { site, telUrl } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** A página de links usa a folha sem carimbo de topo nem rodapé. */
  bare?: boolean;
  noindex?: boolean;
}

const { title, description, bare = false, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/logo.jpeg', Astro.site);

const negocio = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  name: site.nome,
  alternateName: 'Cuca Resolve',
  slogan: site.assinatura,
  description: `${site.categoria} em ${site.regiao}.`,
  image: ogImage.href,
  logo: ogImage.href,
  url: Astro.site?.href,
  telephone: `+${site.whatsapp}`,
  email: site.email,
  areaServed: { '@type': 'City', name: 'Socorro', addressRegion: 'SP', addressCountry: 'BR' },
  address: { '@type': 'PostalAddress', addressLocality: 'Socorro', addressRegion: 'SP', addressCountry: 'BR' },
  knowsAbout: [
    'Marido de aluguel',
    'Manutenção residencial',
    'Reparos elétricos',
    'Reparos hidráulicos',
    'Montagem de móveis',
    'Assistência técnica de eletrodomésticos',
    'Manutenção de computadores',
  ],
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#0b1f3d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.jpeg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary" />

    {/* Fontes próprias, servidas do mesmo domínio: sem terceiro no caminho crítico. */}
    <link
      rel="preload"
      href="/fonts/archivo-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/chivomono-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script type="application/ld+json" set:html={JSON.stringify(negocio)} is:inline />
  </head>

  <body>
    {!bare && <a href="#conteudo" class="skip">Ir para o conteúdo</a>}
    <slot />
    <noscript><a href={telUrl()} class="sr-only">Ligar para {site.whatsapp_exibicao}</a></noscript>
  </body>
</html>
